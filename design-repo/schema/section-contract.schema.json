{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Section contract",
  "description": "Closed shape of every sections/*.json. Checked by extraction/verify_all.py. R7: `source` (provenance: the clone component that renders it) is separate from `semantic` (the AI-facing taxonomy); semantic.id equals the contract id and source.id must not. R8: retrievalEligible is a closed boolean; false requires a 30+ character reason.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "label",
    "tag",
    "purpose",
    "purposeIsInferred",
    "nameSource",
    "evidence",
    "content",
    "constraints",
    "motion",
    "responsive",
    "assetRoles",
    "generatedAssetRoles",
    "implementedBy",
    "semantic",
    "source",
    "retrievalEligible"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z0-9-]+$"
    },
    "category": {
      "enum": [
        "CONTENT",
        "CTA",
        "FEATURES",
        "HERO",
        "PROOF",
        "SHELL",
        "SUPPORT"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$"
    },
    "purpose": {
      "type": "string",
      "minLength": 10
    },
    "purposeIsInferred": {
      "type": "boolean"
    },
    "nameSource": {
      "enum": [
        "class",
        "data-attr"
      ]
    },
    "contentPolicy": {
      "type": "string"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "instances",
        "routes",
        "measuredFrom"
      ],
      "properties": {
        "level": {
          "enum": [
            "measured",
            "inferred"
          ]
        },
        "instances": {
          "type": "integer",
          "minimum": 1
        },
        "routes": {
          "type": "integer",
          "minimum": 1
        },
        "measuredFrom": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^src/[^:]+:\\d+-\\d+$"
          }
        },
        "measuredIn": {
          "type": "string"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "additionalProperties",
        "fields"
      ],
      "properties": {
        "additionalProperties": {
          "const": false
        },
        "budgetSource": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heading": {
              "$ref": "#/definitions/field"
            },
            "subheading": {
              "$ref": "#/definitions/field"
            },
            "body": {
              "$ref": "#/definitions/field"
            },
            "ctas": {
              "$ref": "#/definitions/field"
            },
            "items": {
              "$ref": "#/definitions/field"
            },
            "images": {
              "$ref": "#/definitions/field"
            }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onePerPage": {
          "const": true
        },
        "maxPerPage": {
          "type": "integer",
          "minimum": 2
        },
        "mustBeFirst": {
          "const": true
        },
        "mustBeLast": {
          "const": true
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedPatterns",
        "reducedMotionFallback"
      ],
      "properties": {
        "allowedPatterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "reducedMotionFallback": {
          "type": "string"
        }
      }
    },
    "responsive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measuredAt",
        "breakpoints",
        "desktop",
        "mobile",
        "changes"
      ],
      "properties": {
        "measuredAt": {
          "type": "object"
        },
        "breakpoints": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "desktop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heightPx",
            "columns"
          ],
          "properties": {
            "heightPx": {
              "type": "integer",
              "minimum": 0
            },
            "columns": {
              "type": "integer"
            },
            "heightSource": {
              "type": "string"
            }
          }
        },
        "mobile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heightPx",
            "columns"
          ],
          "properties": {
            "heightPx": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "null = not measured at the mobile viewport"
            },
            "columns": {
              "type": [
                "integer",
                "null"
              ]
            },
            "hiddenShare": {
              "type": "number"
            }
          }
        }
      }
    },
    "assetRoles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "generatedAssetRoles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "implementedBy": {
      "type": "string",
      "pattern": "^src/"
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "enum": [
            "CONTENT",
            "CTA",
            "FEATURES",
            "HERO",
            "PROOF",
            "SHELL",
            "SUPPORT"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tag",
        "file",
        "lines"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "file": {
          "type": "string",
          "pattern": "^src/.+\\.jsx$"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "retrievalEligible": {
      "type": "boolean"
    },
    "retrievalIneligibleReason": {
      "type": "string",
      "minLength": 30
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "retrievalEligible": {
            "const": false
          }
        },
        "required": [
          "retrievalEligible"
        ]
      },
      "then": {
        "required": [
          "retrievalIneligibleReason"
        ]
      },
      "else": {
        "not": {
          "required": [
            "retrievalIneligibleReason"
          ]
        }
      }
    }
  ],
  "definitions": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "required"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "string[]",
            "cta[]",
            "item[]",
            "image[]"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "maxWords": {
          "type": "integer",
          "minimum": 1
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1
        },
        "titleMaxWords": {
          "type": "integer",
          "minimum": 1
        },
        "bodyMaxWords": {
          "type": "integer",
          "minimum": 0
        },
        "assetRoles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
