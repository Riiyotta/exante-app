{
  "version": "0.2.0",
  "derivedFrom": "templates/templates.json and sections/*.json constraints (recomputed by verify_all.py)",
  "rules": [
    {
      "id": "ONE_HERO_PER_PAGE",
      "severity": "error",
      "kind": "maxCategoryPerPage",
      "category": "HERO",
      "max": 1,
      "exceptions": [],
      "description": "A page has at most one HERO section. Templates that genuinely carry more are named in `exceptions`."
    },
    {
      "id": "SECTION_PER_PAGE_LIMITS",
      "severity": "error",
      "kind": "perPageLimits",
      "limits": {
        "content.approach-section": 1,
        "content.article-chapter": 8,
        "content.article-lead": 1,
        "content.blog-section": 1,
        "content.container": 1,
        "content.content-section": 1,
        "content.framer-1h4pb9v-container": 1,
        "content.framer-1nc9gyu-container": 1,
        "content.framer-39uowv-container": 1,
        "content.framer-guhhla-container": 1,
        "content.framer-gzkazm-container": 1,
        "content.framer-huxi9o-container": 1,
        "content.intro-section": 1,
        "content.legal-clause": 20,
        "content.legal-preamble": 1,
        "content.open-roles-section": 1,
        "content.other-articles-section": 1,
        "content.problem-section": 1,
        "content.roi-section": 1,
        "content.team-members-section": 2,
        "content.white": 1,
        "cta.another-cta": 1,
        "cta.cta-section-2": 1,
        "features.benefits-section": 1,
        "features.featured-image-wrapper": 1,
        "features.integrations-section": 1,
        "features.key-features-section": 1,
        "features.other-features-section": 1,
        "hero.hero-section": 1,
        "hero.main": 1,
        "proof.clients-section": 1,
        "proof.testimonials-section": 1,
        "shell.desktop": 1,
        "shell.desktop-filled": 1,
        "support.faq-section": 1
      },
      "description": "No section appears more often on one page than it does in any measured template."
    },
    {
      "id": "SHELL_MUST_BE_FIRST",
      "severity": "error",
      "kind": "mustBeFirst",
      "sections": [
        "content.framer-1h4pb9v-container",
        "content.framer-guhhla-container",
        "content.framer-huxi9o-container",
        "shell.desktop-filled"
      ],
      "description": "Sections that opened every template they appear in must be the first node."
    },
    {
      "id": "SHELL_MUST_BE_LAST",
      "severity": "error",
      "kind": "mustBeLast",
      "sections": [
        "content.framer-1nc9gyu-container",
        "content.framer-39uowv-container",
        "content.framer-gzkazm-container"
      ],
      "description": "Sections that closed every template they appear in must be the last node."
    },
    {
      "id": "NO_CONSECUTIVE_SAME_SECTION",
      "severity": "warn",
      "kind": "noConsecutive",
      "sections": [],
      "description": "These sections were never observed back-to-back."
    },
    {
      "id": "NO_ADJACENT_SAME_CATEGORY",
      "severity": "warn",
      "kind": "noAdjacentSameCategory",
      "exceptions": [
        [
          "content.roi-section",
          "content.problem-section"
        ],
        [
          "features.key-features-section",
          "features.other-features-section"
        ],
        [
          "content.intro-section",
          "content.approach-section"
        ],
        [
          "content.approach-section",
          "content.team-members-section"
        ],
        [
          "content.team-members-section",
          "content.open-roles-section"
        ],
        [
          "content.legal-preamble",
          "content.legal-clause"
        ],
        [
          "content.container",
          "features.featured-image-wrapper"
        ],
        [
          "features.featured-image-wrapper",
          "content.article-lead"
        ],
        [
          "content.article-lead",
          "content.article-chapter"
        ],
        [
          "content.article-chapter",
          "content.other-articles-section"
        ]
      ],
      "description": "Two different sections of the same category should not sit next to each other unless that exact pair was observed (named exceptions)."
    },
    {
      "id": "MOTION_BUDGET",
      "severity": "warn",
      "kind": "maxAnimatedSections",
      "max": 4,
      "description": "No page has more animated sections than the most animated measured page."
    }
  ]
}
